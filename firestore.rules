rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private profiles are owner-only. Public social names live in RTDB.
    // Wallet/entitlement fields are server-only (Cloud Functions use admin SDK).
    match /users/{uid} {
      function profileFields() {
        return ['username', 'email', 'provider', 'avatarURL', 'lastSeen', 'updatedAt'];
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(profileFields());
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields());
      allow delete: if false;
    }

    // Game history is append-only by the owning user.
    match /users/{uid}/history/{eventId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Anything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
