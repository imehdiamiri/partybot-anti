{
  "expo": {
    "name": "PartyBot",
    "slug": "expo-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "partybot",
      "invite"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partybot",
      "appleTeamId": "9R9TPVS9UL",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:partybot.games",
        "applinks:www.partybot.games"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "PartyBot uses the microphone so you can record short voice clips for the Reverse Singing game. Recordings stay on your device and are never uploaded."
      }
    },
    "android": {
      "package": "com.partybot",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#A855F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.partybot.games",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "partybot.games",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      ["expo-audio", {
        "microphonePermission": "PartyBot uses the microphone to record voice clips for Reverse Singing. Recordings stay on your device.",
        "enableBackgroundPlayback": false,
        "enableBackgroundRecording": false
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7949f49-aef7-4963-9d95-5eb35280136e"
      }
    },
    "owner": "imehdiamiri",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b7949f49-aef7-4963-9d95-5eb35280136e"
    }
  }
}
