{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": "website/public",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.env*",
      "**/.DS_Store"
    ],
    "rewrites": [
      {
        "source": "/auth",
        "destination": "/app.html"
      },
      {
        "source": "/auth/**",
        "destination": "/app.html"
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "destination": "/apple-app-site-association"
      },
      {
        "source": "/play",
        "destination": "/app.html"
      },
      {
        "source": "/play/**",
        "destination": "/app.html"
      },
      {
        "source": "/game/*/session",
        "destination": "/game/[id]/session.html"
      },
      {
        "source": "/game/*/setup",
        "destination": "/game/[id]/setup.html"
      },
      {
        "source": "/game/*",
        "destination": "/game/[id].html"
      },
      {
        "source": "/cards/*",
        "destination": "/cards/[categoryId].html"
      },
      {
        "source": "/lobby/*",
        "destination": "/lobby/[roomCode].html"
      }
    ],
    "headers": [
      {
        "source": "**/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/play",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/play/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/game/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/cards/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/lobby/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/tools/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(tools|friends|profile|paywall|onboarding|invite|auth|team-setup|teams|bottle|coin|dice|hourglass|wheel|purchase-detail|_sitemap)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "emulators": {
    "database": {
      "port": 9012
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
